APP_NAME=Fruit Quote API
API_PREFIX=/api
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/fruit_quote?charset=utf8mb4
JWT_SECRET_KEY=change-me-before-production
JWT_EXPIRE_MINUTES=43200
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_NOTIFY_EMAIL=
WECHAT_APPID=
WECHAT_SECRET=
# ---- 微信支付（B2b 门店助手 · wx.requestCommonPayment）----
# 凭证未到位前保持 WECHAT_PAY_MOCK=true，用 Mock 模式端到端联调
# 门店助手申请的商户号（小程序后台 → 门店助手 → 支付管理）
WECHAT_PAY_MCHID=
# 支付环境：0 现网 / 1 沙箱（沙箱仅开发版/体验版可用，正式发布必须 0）
WECHAT_PAY_ENV=0
# 现网 AppKey（门店助手 → 支付管理 → 商户号管理 → 查看详情 → 基本配置）
WECHAT_PAY_APPKEY=
# 沙箱 AppKey（仅 WECHAT_PAY_ENV=1 联调时需要）
WECHAT_PAY_SANDBOX_APPKEY=
# 小程序「消息推送」配置的 Token（mp 后台 → 开发 → 开发管理 → 消息推送）
# 用于支付/退款结果通知（retail_pay_notify / retail_refund_notify）验签与 URL 校验
WECHAT_B2B_MSG_TOKEN=
WECHAT_PAY_MOCK=true
# 店铺认证功能开关：false=屏蔽认证（快速上线验证期），true=恢复
VERIFICATION_ENABLED=true
# 待支付订单超时自动关闭时长（分钟），<=0 表示不自动关单
ORDER_UNPAID_TIMEOUT_MINUTES=15
