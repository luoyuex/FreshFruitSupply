APP_NAME=Fruit Quote API
API_PREFIX=/api
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/fruit_quote?charset=utf8mb4
JWT_SECRET_KEY=change-me-before-production
JWT_EXPIRE_MINUTES=43200
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_NOTIFY_EMAIL=
WECHAT_APPID=
WECHAT_SECRET=
# ---- 微信支付（小程序 JSAPI）----
# 商户凭证未到位前保持 WECHAT_PAY_MOCK=true，用 Mock 模式端到端联调
WECHAT_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=
# 商户 API 证书私钥文件路径（apiclient_key.pem），不要提交进仓库
# 用途：给发往微信的请求签名（下单/查单/关单/退款都必须）
WECHAT_PAY_PRIVATE_KEY_PATH=
# 微信支付公钥文件路径（pub_key.pem），用途：验证微信回调签名
WECHAT_PAY_PUBLIC_KEY_PATH=
# 微信支付公钥 ID（形如 PUB_KEY_ID_0114xxx），商户平台可查；与上面成对填写
WECHAT_PAY_PUBLIC_KEY_ID=
# 支付结果回调地址，必须公网可访问的 HTTPS，例如 https://api.example.com/api/payments/wechat/notify
WECHAT_PAY_NOTIFY_URL=
# 退款结果回调地址（可选，需公网 HTTPS）；不填则退款按“受理成功”记账
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_MOCK=true
# 待支付订单超时自动关闭时长（分钟），<=0 表示不自动关单
ORDER_UNPAID_TIMEOUT_MINUTES=15
